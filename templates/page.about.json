		"collapsible-content": {
			"type": "collapsible-content",
			"blocks": {
				"block_1": {
					"type": "accordion",
					"settings": {
						"question": "What warranty do you offer on the electronics purchased from your store?",
						"answer": "<p>All electronics purchased from our store come with a standard 12-month manufacturer's warranty. Extended warranties are also available for select products at an additional cost. Please refer to the product details page or speak with our customer service for specific warranty information on individual items.</p>",
						"opened": true
					}
				},
				"block_2": {
					"type": "accordion",
					"settings": {
						"question": "Do you offer any installment plans or financing options for high-ticket items?",
						"answer": "<p>Yes, we do offer installment plans for eligible products above a certain price threshold. We have partnered with several financial institutions to provide flexible financing options. Please visit our financing page or consult with our in-store representatives to learn more about terms and conditions.</p>",
						"opened": false
					}
				},
				"block_3": {
					"type": "accordion",
					"settings": {
						"question": "Can I return or exchange a product if I'm not satisfied?",
						"answer": "<p>Absolutely! We have a 30-day return policy for items in their original, unopened packaging. If you've opened the product but found it defective or not to your satisfaction, you can bring it back within 14 days for an exchange. Some exclusions may apply, so we recommend checking our detailed return and exchange policy or consulting with our customer service team.</p>",
						"opened": false
					}
				},
				"795a5544-8e27-4515-8387-d695fc6deeed": {
					"type": "accordion",
					"settings": {
						"question": "Do you provide technical support or assistance for setting up purchased electronics?",
						"answer": "<p>Yes, we have a dedicated technical support team available both online and in-store. They can assist you with setup, troubleshooting, and any technical questions you might have about your purchase. Additionally, we offer extended technical support packages for select products to provide you with long-term assistance.</p>",
						"opened": false
					}
				}
			},
